# Copia este archivo como .env y completa los valores.
# database/setup.ps1 crea el .env solo con DATABASE_URL, PORT y JWT_SECRET; el resto se agrega a mano.

# --- Base de datos y servidor (obligatorias) ---
DATABASE_URL=postgresql://postgres:CONTRASENA@localhost:5432/sgim
PORT=3000
JWT_SECRET=una-cadena-larga-y-aleatoria
FRONTEND_ORIGIN=http://localhost:5173

# --- WhatsApp Cloud API (sin WA_TOKEN el chatbot queda desactivado) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_APP_ID=
WA_API_VERSION=v25.0
# URL fija del webhook en producción (vacía en local)
WA_WEBHOOK_PRODUCCION=

# --- Agente de IA: Gemini (sin clave se usa el flujo guiado sin IA) ---
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest
GEMINI_MODELO_RESPALDO=gemini-flash-lite-latest,gemini-3.1-flash-lite

# --- Solo para Vercel ---
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
# Ruta de cloudflared si no está en el PATH (npm run tunel)
CLOUDFLARED_PATH=

# --- Correo de recuperación de contraseña (Gmail con «contraseña de aplicación») ---
# CORREO_USUARIO = la cuenta de Gmail que envía; CORREO_CLAVE_APP = las 16 letras que da Google (con o sin espacios).
# Vacías: no se envía correo y el enlace sale en la consola del backend.
CORREO_USUARIO=
CORREO_CLAVE_APP=
# Dirección pública del panel para los enlaces (en Vercel se detecta sola; en local es http://localhost:5173)
APP_URL=
